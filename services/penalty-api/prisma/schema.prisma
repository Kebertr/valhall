// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum approveStatus {
  PENDING
  APPROVED
  DENIED
}

model Add {
  id         String        @id @default(uuid())
  fromId     String
  toId       String
  acceptedId String?
  amount     Int
  reason     String
  status     approveStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

model Redemption {
  id         String        @id @default(uuid())
  toId       String
  acceptedId String?
  amount     Int
  videoId    String
  status     approveStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  @@index([toId])
}

model BongBalance {
  memberId      String   @id
  totalAdded    Int      @default(0)
  totalTaken    Int      @default(0)
  totalPending  Int      @default(0)
  currentAmount Int      @default(0)
  updatedAt     DateTime @updatedAt
}

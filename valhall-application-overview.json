      "targets": [
        {
          "editorMode": "code",
          "expr": "100 *\nsum(\n  increase(http_request_duration_seconds_count{\n    namespace=~\"$namespace\",\n    service=~\"$service\",\n    path!=\"/metrics\",\n    status_code=~\"4..\"\n  }[$__range])\n)\n/\nclamp_min(\n  sum(\n    increase(http_request_duration_seconds_count{\n      namespace=~\"$namespace\",\n      service=~\"$service\",\n      path!=\"/metrics\"\n    }[$__range])\n  ),\n  1\n)",
